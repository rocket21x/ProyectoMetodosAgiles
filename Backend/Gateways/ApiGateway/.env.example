USER_SERVICE_URL=http://localhost:3001
BUSINESS_SERVICE_URL=http://localhost:3006
EXPERIENCE_SERVICE_URL=http://localhost:3002
BOOKING_SERVICE_URL=http://localhost:3004
PAYMENT_SERVICE_URL=http://localhost:3005
